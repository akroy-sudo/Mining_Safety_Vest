[{"id":"smart_vest_tab","type":"tab","label":"Mining Safety Vest Dashboard","disabled":false,"info":""},{"id":"mqtt_in_data","type":"mqtt in","z":"smart_vest_tab","name":"Sensor Data","topic":"vest/data","qos":"0","datatype":"auto","broker":"mqtt_hivemq","inputs":0,"x":140,"y":80,"wires":[["json_parse"]]},{"id":"json_parse","type":"json","z":"smart_vest_tab","name":"Parse JSON","property":"payload","action":"obj","pretty":false,"x":320,"y":80,"wires":[["split_data"]]},{"id":"split_data","type":"function","z":"smart_vest_tab","name":"Split Sensor Values","func":"let data = msg.payload || {};\nlet temp = data.Temperature || 0;\nlet hum = data.Humidity || 0;\nlet mq135 = data.MQ135 || 0;\nlet mq7 = data.MQ7 || 0;\nlet fall = data.Fall ? 'Detected ⚠️' : 'No Fall';\nlet sos = data.SOS ? 'Active 🚨' : 'Normal';\nlet rockfall = data.MPU6050 || 0;\nlet zone = data.Zone || 'Zone 1';\n\n// Individual messages\nlet tempMsg = {payload: temp};\nlet humMsg = {payload: hum};\nlet mq135Msg = {payload: mq135};\nlet mq7Msg = {payload: mq7};\nlet fallMsg = {payload: fall};\nlet sosMsg = {payload: sos};\nlet rockfallMsg = {payload: rockfall};\nlet zoneMsg = {payload: zone};\n\n// Chart data\nlet chartMsg = {\n    payload: [\n        { series: [\"Temperature\"], data: [[temp]], labels: [new Date().toLocaleTimeString()]},\n        { series: [\"Humidity\"], data: [[hum]], labels: [new Date().toLocaleTimeString()]},\n        { series: [\"MQ135\"], data: [[mq135]], labels: [new Date().toLocaleTimeString()]},\n        { series: [\"MQ7\"], data: [[mq7]], labels: [new Date().toLocaleTimeString()]}\n    ]\n};\n\n// Event Log message\nlet logMsg = {payload: []};\nif(sos === 'Active 🚨') logMsg.payload.push({msg: 'SOS Triggered in ' + zone, type:'sos'});\nif(fall === 'Detected ⚠️') logMsg.payload.push({msg: 'Fall Detected in ' + zone, type:'fall'});\nif(mq135 > 800 || mq7 > 500) logMsg.payload.push({msg: 'Gas Alert! MQ135:' + mq135 + ' MQ7:' + mq7, type:'gas'});\n\nreturn [tempMsg, humMsg, mq135Msg, mq7Msg, fallMsg, sosMsg, rockfallMsg, zoneMsg, chartMsg, logMsg];","outputs":10,"noerr":0,"x":520,"y":80,"wires":[["ui_temp"],["ui_hum"],["ui_mq135"],["ui_mq7"],["ui_fall"],["ui_sos"],["ui_rockfall"],["ui_zone"],["ui_chart"],["ui_event_log"]]},{"id":"ui_temp","type":"ui_gauge","z":"smart_vest_tab","name":"Temperature","group":"grp_env","order":1,"width":6,"height":6,"gtype":"donut","title":"🌡️ Temperature (°C)","label":"°C","format":"{{value}}","min":0,"max":60,"colors":["#00bcd4","#8bc34a","#f44336"],"x":0,"y":0,"wires":[]},{"id":"ui_hum","type":"ui_gauge","z":"smart_vest_tab","name":"Humidity","group":"grp_env","order":2,"width":6,"height":6,"gtype":"donut","title":"💧 Humidity (%)","label":"%","format":"{{value}}","min":0,"max":100,"colors":["#2196f3","#8bc34a","#ff9800"],"x":0,"y":0,"wires":[]},{"id":"ui_mq135","type":"ui_gauge","z":"smart_vest_tab","name":"Air Quality (MQ135)","group":"grp_gas","order":1,"width":6,"height":6,"gtype":"wave","title":"🌫️ Air Quality (MQ135)","label":"ppm","format":"{{value}}","min":0,"max":2000,"colors":["#00e676","#ffeb3b","#ff1744"],"x":0,"y":0,"wires":[]},{"id":"ui_mq7","type":"ui_gauge","z":"smart_vest_tab","name":"CO Level (MQ7)","group":"grp_gas","order":2,"width":6,"height":6,"gtype":"wave","title":"🔥 CO Level (MQ7)","label":"ppm","format":"{{value}}","min":0,"max":1500,"colors":["#00e676","#ffeb3b","#ff1744"],"x":0,"y":0,"wires":[]},{"id":"ui_fall","type":"ui_template","z":"smart_vest_tab","group":"grp_status","name":"Fall Status","order":1,"width":6,"height":1,"format":"<div id='fall_alert' style='width:100%;font-size:22px;text-align:center;color:white;background:gray;border-radius:5px;'>🧍 Fall Detection: {{msg.payload}}</div>\n<script>\nif('{{msg.payload}}' === 'Detected ⚠️'){\n  var el = document.getElementById('fall_alert');\n  setInterval(()=>{ el.style.background = el.style.background === 'red'?'gray':'red'; },500);\n}\n</script>","x":0,"y":0,"wires":[[]]},{"id":"ui_sos","type":"ui_template","z":"smart_vest_tab","group":"grp_status","name":"SOS Status","order":2,"width":6,"height":1,"format":"<div id='sos_alert' style='width:100%;font-size:22px;text-align:center;color:white;background:gray;border-radius:5px;'>🚨 SOS Status: {{msg.payload}}</div>\n<script>\nif('{{msg.payload}}' === 'Active 🚨'){\n  var el = document.getElementById('sos_alert');\n  setInterval(()=>{ el.style.background = el.style.background === 'red'?'gray':'red'; },300);\n}\n</script>","x":0,"y":0,"wires":[[]]},{"id":"ui_rockfall","type":"ui_gauge","z":"smart_vest_tab","name":"Rockfall Risk","group":"grp_status","order":3,"width":6,"height":6,"gtype":"donut","title":"🪨 Rockfall Risk","label":"%","format":"{{value}}","min":0,"max":100,"colors":["#00e676","#ffeb3b","#ff1744"],"x":0,"y":0,"wires":[]},{"id":"ui_zone","type":"ui_template","z":"smart_vest_tab","group":"grp_status","name":"Current Zone","order":4,"width":6,"height":1,"format":"<div style='width:100%;text-align:center;font-size:20px;padding:5px;border-radius:5px;background-color:#2196f3;color:white;'>📍 {{msg.payload}}</div>","x":0,"y":0,"wires":[[]]},{"id":"ui_chart","type":"ui_chart","z":"smart_vest_tab","name":"Sensor Trends","group":"grp_graphs","order":1,"width":12,"height":6,"chartType":"line","legend":"true","xformat":"HH:mm:ss","interpolate":"linear","nodata":"Waiting for data...","dot":false,"ymin":"0","ymax":"2000","removeOlder":1,"removeOlderPoints":"60","removeOlderUnit":"60","useOneColor":false,"colors":["#03a9f4","#8bc34a","#ff5722","#e91e63"],"outputs":1,"x":520,"y":220,"wires":[[]]},{"id":"ui_event_log","type":"ui_template","z":"smart_vest_tab","group":"grp_graphs","name":"Event Log","order":2,"width":12,"height":6,"format":"<div style='background:#222;color:#0f0;height:100%;overflow-y:auto;padding:5px;border-radius:5px;font-family:monospace;'><ul id='log_list'></ul></div>\n<script>\nvar logUl = document.getElementById('log_list');\n(msg.payload||[]).forEach(item => {\n  var li = document.createElement('li');\n  li.textContent = item.msg;\n  if(item.type==='sos') li.style.color='red';\n  else if(item.type==='fall') li.style.color='orange';\n  else if(item.type==='gas') li.style.color='yellow';\n  logUl.insertBefore(li, logUl.firstChild);\n});\n</script>","x":520,"y":380,"wires":[[]]},{"id":"mqtt_hivemq","type":"mqtt-broker","name":"HiveMQ Public Broker","broker":"broker.hivemq.com","port":"1883","clientid":"NodeRED_SafetyVest_UI","usetls":false,"protocolVersion":"4","keepalive":"60","cleansession":true},{"id":"grp_env","type":"ui_group","name":"🌡️ Environment","tab":"main_tab","order":1,"disp":true,"width":6},{"id":"grp_gas","type":"ui_group","name":"☣️ Gas Sensors","tab":"main_tab","order":2,"disp":true,"width":6},{"id":"grp_status","type":"ui_group","name":"🧍 Safety Status","tab":"main_tab","order":3,"disp":true,"width":6},{"id":"grp_graphs","type":"ui_group","name":"📊 Sensor Graphs","tab":"main_tab","order":4,"disp":true,"width":12},{"id":"main_tab","type":"ui_tab","name":"Mining Safety Vest","icon":"dashboard","disabled":false,"hidden":false},{"id":"9fc0ad41ebfa3468","type":"global-config","env":[],"modules":{"node-red-dashboard":"3.6.6"}}]